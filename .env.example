# Copy this file to `.env` and fill in values. Never commit `.env`.

VENDORUS_ENV=development
LOG_LEVEL=INFO

# Leave blank to use the local SQLite file at data/vendorus.db.
# Later, for PostgreSQL: postgresql+psycopg://user:password@localhost:5432/vendorus
DATABASE_URL=

